<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="zpl_device_company" model="ir.rule">
        <field name="name">Community IoT ZPL: devices in allowed companies</field>
        <field name="model_id" ref="community_iot_box.model_community_iot_box_iot_device"/>
        <field name="groups" eval="[(4, ref('community_iot_zpl.group_community_iot_zpl_user'))]"/>
        <field name="domain_force">[('box_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="zpl_box_company" model="ir.rule">
        <field name="name">Community IoT ZPL: boxes in allowed companies</field>
        <field name="model_id" ref="community_iot_box.model_community_iot_box_iot_box"/>
        <field name="groups" eval="[(4, ref('community_iot_zpl.group_community_iot_zpl_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
