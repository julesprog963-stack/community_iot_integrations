<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="scale_device_company" model="ir.rule">
        <field name="name">Community IoT SCALE: devices in allowed companies</field>
        <field name="model_id" ref="community_iot_box.model_community_iot_box_iot_device"/>
        <field name="groups" eval="[(4, ref('community_iot_scale.group_community_iot_scale_user'))]"/>
        <field name="domain_force">[('box_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="scale_box_company" model="ir.rule">
        <field name="name">Community IoT SCALE: boxes in allowed companies</field>
        <field name="model_id" ref="community_iot_box.model_community_iot_box_iot_box"/>
        <field name="groups" eval="[(4, ref('community_iot_scale.group_community_iot_scale_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
